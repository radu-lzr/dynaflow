meta {
  name: Register Technician
  type: http
  seq: 2
}

post {
  url: {{authUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "tech@dynolab.com",
    "password": "techpass123",
    "firstName": "Jean",
    "lastName": "Technicien",
    "accountType": "internal"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
}

script:post-response {
  bru.setVar("techId", res.body.id);
}
