meta {
  name: Register Admin
  type: http
  seq: 1
}

post {
  url: {{authUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "adminpass123",
    "firstName": "Admin",
    "lastName": "DynoLab",
    "accountType": "internal"
  }
}

tests {
  test("status 201 or 409", function() {
    expect([201, 409]).to.include(res.status);
  });
  test("has id when created", function() {
    if (res.status === 201) {
      expect(res.body.id).to.be.a("string");
    }
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}

script:post-response {
  if (res.body.id) {
    bru.setVar("adminId", res.body.id);
  }
}
