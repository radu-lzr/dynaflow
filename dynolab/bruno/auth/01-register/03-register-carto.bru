meta {
  name: Register Cartographer
  type: http
  seq: 3
}

post {
  url: {{authUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "carto@dynolab.com",
    "password": "cartopass123",
    "firstName": "Marie",
    "lastName": "Cartographe",
    "accountType": "internal"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
}

script:post-response {
  bru.setVar("cartoId", res.body.id);
}
