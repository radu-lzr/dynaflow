meta {
  name: Register Cartographer
  type: http
  seq: 3
}

post {
  url: {{authUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{cartoEmail}}",
    "password": "cartopass123",
    "firstName": "Marie",
    "lastName": "Cartographe",
    "accountType": "internal"
  }
}

tests {
  test("status 201 or 409", function() {
    expect([201, 409]).to.include(res.status);
  });
  test("has id when created", function() {
    if (res.status === 201) {
      expect(res.body.id).to.be.a("string");
    }
  });
}

script:post-response {
  if (res.body.id) {
    bru.setVar("cartoId", res.body.id);
  }
}
