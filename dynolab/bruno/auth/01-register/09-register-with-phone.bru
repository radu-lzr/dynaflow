meta {
  name: Register With Phone Number
  type: http
  seq: 9
}

post {
  url: {{authUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "phone@test.com",
    "password": "testpass123",
    "firstName": "With",
    "lastName": "Phone",
    "accountType": "internal",
    "phone": "+32470123456"
  }
}

tests {
  test("status 201 or 409", function() {
    expect([201, 409]).to.include(res.status);
  });
  test("has id when created", function() {
    if (res.status === 201) {
      expect(res.body.id).to.be.a("string");
    }
  });
}
