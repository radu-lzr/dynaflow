post {
  url: {{authUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "short@test.com",
    "password": "123",
    "firstName": "Short",
    "lastName": "Pass",
    "accountType": "internal"
  }
}

tests {
  test("status 400", function() {
    expect(res.status).to.equal(400);
  });
