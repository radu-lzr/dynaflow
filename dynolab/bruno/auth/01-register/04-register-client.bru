meta {
  name: Register Client
  type: http
  seq: 4
}

post {
  url: {{authUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{clientEmail}}",
    "password": "clientpass123",
    "firstName": "Pierre",
    "lastName": "Client",
    "accountType": "client"
  }
}

tests {
  test("status 201 or 409", function() {
    expect([201, 409]).to.include(res.status);
  });
  test("has id when created", function() {
    if (res.status === 201) {
      expect(res.body.id).to.be.a("string");
    }
  });
}

script:post-response {
  if (res.body.id) {
    bru.setVar("clientId", res.body.id);
  }
}
