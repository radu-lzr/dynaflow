meta {
  name: Register Client
  type: http
  seq: 4
}

post {
  url: {{authUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "client@dynolab.com",
    "password": "clientpass123",
    "firstName": "Pierre",
    "lastName": "Client",
    "accountType": "client"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
}

script:post-response {
  bru.setVar("clientId", res.body.id);
}
