meta {
  name: Login Admin
  type: http
  seq: 1
}

post {
  url: {{authUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "Admin123!"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has accessToken", function() {
    expect(res.body.accessToken).to.be.a("string");
  });
  test("has refreshToken", function() {
    expect(res.body.refreshToken).to.be.a("string");
  });
  test("has expiresIn", function() {
    expect(res.body.expiresIn).to.be.a("number");
  });
}

script:post-response {
  bru.setVar("adminAccessToken", res.body.accessToken);
  bru.setVar("adminRefreshToken", res.body.refreshToken);
}
