meta {
  name: Login Wrong Password (401)
  type: http
  seq: 3
}

post {
  url: {{authUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "wrongpassword"
  }
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
