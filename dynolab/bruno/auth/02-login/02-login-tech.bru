meta {
  name: Login Technician
  type: http
  seq: 2
}

post {
  url: {{authUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "tech@dynolab.com",
    "password": "techpass123"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has accessToken", function() {
    expect(res.body.accessToken).to.be.a("string");
  });
  test("has refreshToken", function() {
    expect(res.body.refreshToken).to.be.a("string");
  });
}

script:post-response {
  bru.setVar("techAccessToken", res.body.accessToken);
  bru.setVar("techRefreshToken", res.body.refreshToken);
}
