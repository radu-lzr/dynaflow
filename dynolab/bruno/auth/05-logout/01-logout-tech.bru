meta {
  name: Logout Technician
  type: http
  seq: 1
}

post {
  url: {{authUrl}}/auth/logout
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{techAccessToken}}
}

body:json {
  {
    "refreshToken": "{{techRefreshToken}}"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
