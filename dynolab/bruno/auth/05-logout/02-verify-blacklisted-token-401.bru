meta {
  name: Verify Blacklisted Tech Token (401)
  type: http
  seq: 2
}

post {
  url: {{authUrl}}/auth/verify
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{techAccessToken}}
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
