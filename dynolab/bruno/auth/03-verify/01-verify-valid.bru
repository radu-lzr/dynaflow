meta {
  name: Verify Valid Token
  type: http
  seq: 1
}

post {
  url: {{authUrl}}/auth/verify
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has userId", function() {
    expect(res.body.userId).to.be.a("string");
  });
  test("has accountType", function() {
    expect(res.body.accountType).to.be.a("string");
  });
  test("userId matches adminId", function() {
    const adminId = bru.getVar("adminId");
    if (adminId) {
      expect(res.body.userId).to.equal(adminId);
    }
  });
  test("response header X-User-Id is set", function() {
    expect(res.headers["x-user-id"]).to.be.a("string");
  });
  test("response header X-Account-Type is set", function() {
    expect(res.headers["x-account-type"]).to.be.a("string");
  });
  test("X-User-Id matches body userId", function() {
    expect(res.headers["x-user-id"]).to.equal(res.body.userId);
  });
}

script:post-response {
  bru.setVar("adminId", res.body.userId);
}
