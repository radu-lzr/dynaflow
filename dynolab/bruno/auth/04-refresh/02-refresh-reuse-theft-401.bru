meta {
  name: Refresh Reused Token — Theft Detection (401)
  type: http
  seq: 2
}

post {
  url: {{authUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{adminRefreshTokenUsed}}"
  }
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
