meta {
  name: Re-Login Admin (Theft Revoked All Sessions)
  type: http
  seq: 4
}

post {
  url: {{authUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@dynolab.com",
    "password": "adminpass123"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has accessToken", function() {
    expect(res.body.accessToken).to.be.a("string");
  });
}

script:post-response {
  bru.setVar("adminAccessToken", res.body.accessToken);
  bru.setVar("adminRefreshToken", res.body.refreshToken);
}
