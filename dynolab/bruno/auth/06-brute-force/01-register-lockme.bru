meta {
  name: Register Lockme User
  type: http
  seq: 1
}

post {
  url: {{authUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{lockmeEmail}}",
    "password": "lockmepass123",
    "firstName": "Lock",
    "lastName": "Me",
    "accountType": "internal"
  }
}

tests {
  test("status 201 or 409", function() {
    expect([201, 409]).to.include(res.status);
  });
}
