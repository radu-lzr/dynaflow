meta {
  name: Update User With Empty Body (400)
  type: http
  seq: 8
}

put {
  url: {{authUrl}}/users/{{adminId}}
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {}
}

tests {
  test("status 400", function() {
    expect(res.status).to.equal(400);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
