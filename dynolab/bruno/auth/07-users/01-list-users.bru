meta {
  name: List Users
  type: http
  seq: 1
}

get {
  url: {{authUrl}}/users
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has users array", function() {
    expect(res.body.users).to.be.an("array");
  });
  test("has totalCount", function() {
    expect(res.body.totalCount).to.be.a("number");
  });
  test("has page", function() {
    expect(res.body.page).to.be.a("number");
  });
}
