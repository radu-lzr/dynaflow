meta {
  name: Filter Users By Account Type
  type: http
  seq: 3
}

get {
  url: {{authUrl}}/users?accountType=client
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("all results are clients", function() {
    res.body.users.forEach(function(u) {
      expect(u.accountType).to.equal("client");
    });
  });
}

script:post-response {
  if (res.body.users && res.body.users.length > 0) {
    bru.setVar("clientId", res.body.users[0].id);
  }
}
