meta {
  name: Update Non-Existent User (404)
  type: http
  seq: 9
}

put {
  url: {{authUrl}}/users/00000000-0000-0000-0000-000000000000
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "firstName": "Ghost"
  }
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
