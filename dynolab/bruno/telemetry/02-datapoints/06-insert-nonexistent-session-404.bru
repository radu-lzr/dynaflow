meta {
  name: Insert Datapoints - Nonexistent Session 404
  type: http
  seq: 6
}

post {
  url: {{telemetryUrl}}/bench-sessions/00000000-0000-0000-0000-000000000000/datapoints
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "datapoints": [
      { "timestamp": "2026-01-15T10:00:00Z", "rpm": 3000, "horsepower": 150 }
    ]
  }
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
