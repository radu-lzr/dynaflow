meta {
  name: List Bench Sessions
  type: http
  seq: 3
}

get {
  url: {{telemetryUrl}}/bench-sessions
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has sessions array", function() {
    expect(res.body.sessions).to.be.an("array");
  });
  test("has totalCount", function() {
    expect(res.body.totalCount).to.be.a("number");
  });
  test("has page", function() {
    expect(res.body.page).to.be.a("number");
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
