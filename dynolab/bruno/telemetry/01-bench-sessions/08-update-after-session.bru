meta {
  name: Update After Session - Close with Peaks
  type: http
  seq: 8
}

put {
  url: {{telemetryUrl}}/bench-sessions/{{afterSessionId}}
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "peakHp": 285,
    "peakTorque": 410,
    "endedAt": "2026-01-15T14:45:00Z"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
