meta {
  name: Create Before Session
  type: http
  seq: 1
}

post {
  url: {{telemetryUrl}}/bench-sessions
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "interventionId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
    "type": "before",
    "startedAt": "2026-01-15T09:00:00Z",
    "notes": "Before ECU remap baseline run"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}

script:post-response {
  if (res.body.id) {
    bru.setVar("beforeSessionId", res.body.id);
  }
}
