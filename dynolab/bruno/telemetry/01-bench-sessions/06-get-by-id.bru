meta {
  name: Get Bench Session By Id
  type: http
  seq: 6
}

get {
  url: {{telemetryUrl}}/bench-sessions/{{beforeSessionId}}
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("id matches", function() {
    expect(res.body.id).to.equal(bru.getVar("beforeSessionId"));
  });
  test("has datapointCount", function() {
    expect(res.body.datapointCount).to.be.a("number");
  });
  test("has obdLogCount", function() {
    expect(res.body.obdLogCount).to.be.a("number");
  });
  test("has interventionId", function() {
    expect(res.body.interventionId).to.be.a("string");
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
