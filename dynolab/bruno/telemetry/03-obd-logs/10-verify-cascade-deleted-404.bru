meta {
  name: Verify Deleted Session Returns 404
  type: http
  seq: 10
}

get {
  url: {{telemetryUrl}}/bench-sessions/{{afterSessionId}}
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
