meta {
  name: Bulk Insert OBD Logs
  type: http
  seq: 1
}

post {
  url: {{telemetryUrl}}/bench-sessions/{{beforeSessionId}}/obd-logs
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "logs": [
      { "timestamp": "2026-01-15T10:00:00Z", "pid": "010C", "value": 800, "unit": "rpm" },
      { "timestamp": "2026-01-15T10:00:00Z", "pid": "0105", "value": 82, "unit": "°C" },
      { "timestamp": "2026-01-15T10:00:00Z", "pid": "010B", "value": 101.3, "unit": "kPa" },
      { "timestamp": "2026-01-15T10:00:01Z", "pid": "010C", "value": 2500, "unit": "rpm" },
      { "timestamp": "2026-01-15T10:00:01Z", "pid": "0105", "value": 85, "unit": "°C" },
      { "timestamp": "2026-01-15T10:00:01Z", "pid": "010B", "value": 145.2, "unit": "kPa" }
    ]
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("insertedCount is 6", function() {
    expect(res.body.insertedCount).to.equal(6);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
