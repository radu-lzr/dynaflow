meta {
  name: Delete OBD Logs for Session
  type: http
  seq: 7
}

delete {
  url: {{telemetryUrl}}/bench-sessions/{{beforeSessionId}}/obd-logs
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("deletedCount is 6", function() {
    expect(res.body.deletedCount).to.equal(6);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
