meta {
  name: Delete Datapoints for Session
  type: http
  seq: 8
}

delete {
  url: {{telemetryUrl}}/bench-sessions/{{beforeSessionId}}/datapoints
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("deletedCount is 10", function() {
    expect(res.body.deletedCount).to.equal(10);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
