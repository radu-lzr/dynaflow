meta {
  name: Delete Session - Cascades Datapoints and Logs
  type: http
  seq: 9
}

delete {
  url: {{telemetryUrl}}/bench-sessions/{{afterSessionId}}
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
