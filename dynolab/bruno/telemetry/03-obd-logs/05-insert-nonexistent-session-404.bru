meta {
  name: Insert OBD Logs - Nonexistent Session 404
  type: http
  seq: 5
}

post {
  url: {{telemetryUrl}}/bench-sessions/00000000-0000-0000-0000-000000000000/obd-logs
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "logs": [
      { "timestamp": "2026-01-15T10:00:00Z", "pid": "010C", "value": 800 }
    ]
  }
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
