meta {
  name: Download Version File
  type: http
  seq: 5
}

get {
  url: {{mapUrl}}/maps/{{mapGtiStage1Id}}/versions/{{versionId1}}/download
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("content-type is octet-stream", function() {
    expect(res.headers["content-type"]).to.include("application/octet-stream");
  });
}
