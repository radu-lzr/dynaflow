meta {
  name: Upload Duplicate Version - 409
  type: http
  seq: 3
}

post {
  url: {{mapUrl}}/maps/{{mapGtiStage1Id}}/versions
  body: multipart-form
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:multipart-form {
  versionNumber: 1.0
  changelog: This should fail - duplicate version
  file: @file(map/test-files/test.bin)
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });
  test("has error message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
