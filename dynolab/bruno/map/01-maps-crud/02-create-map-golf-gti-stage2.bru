meta {
  name: Create Map - Golf GTI Stage 2
  type: http
  seq: 2
}

post {
  url: {{mapUrl}}/maps
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "name": "Golf GTI Stage 2 - EA888 Gen3 + TIP",
    "configId": "aaaaaaaaaaaaaaaaaaaaaaaa",
    "type": "stage2",
    "description": "Stage 2 remap, requires upgraded intercooler and TIP",
    "authorId": "{{adminId}}"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
}

script:post-response {
  if (res.body.id) {
    bru.setVar("mapGtiStage2Id", res.body.id);
  }
}
