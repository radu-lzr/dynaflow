meta {
  name: Get Non-existent Map - 404
  type: http
  seq: 11
}

get {
  url: {{mapUrl}}/maps/00000000-0000-4000-8000-000000000000
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
