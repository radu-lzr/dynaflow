meta {
  name: List Maps - Filter by Search
  type: http
  seq: 8
}

get {
  url: {{mapUrl}}/maps?search=GTI
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("returns results", function() {
    expect(res.body.maps).to.be.an("array");
    expect(res.body.maps.length).to.be.at.least(1);
  });
}
