meta {
  name: List Maps - Filter by Type
  type: http
  seq: 5
}

get {
  url: {{mapUrl}}/maps?type=stage1
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("all maps are stage1", function() {
    res.body.maps.forEach(function(m) {
      expect(m.type).to.equal("stage1");
    });
  });
}
