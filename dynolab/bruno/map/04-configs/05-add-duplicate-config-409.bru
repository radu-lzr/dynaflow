meta {
  name: Add Duplicate Config - 409
  type: http
  seq: 5
}

post {
  url: {{mapUrl}}/maps/{{mapGtiStage1Id}}/configs
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "configId": "cccccccccccccccccccccccc",
    "notes": "Duplicate - should fail"
  }
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });
  test("has error message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
