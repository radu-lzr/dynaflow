}

body:json {
  {
    "configId": "dddddddddddddddddddddddd",
    "notes": "Audi A3 8V 2.0T - same hardware platform"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
}
