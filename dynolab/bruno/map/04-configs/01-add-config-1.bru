meta {
  name: Add Compatible Config 1
  type: http
  seq: 1
}

post {
  url: {{mapUrl}}/maps/{{mapGtiStage1Id}}/configs
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "configId": "cccccccccccccccccccccccc",
    "notes": "Golf GTI 7.5 facelift - same ECU pinout"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
