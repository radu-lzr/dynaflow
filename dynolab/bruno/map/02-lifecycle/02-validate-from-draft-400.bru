meta {
  name: Validate from draft - 400 invalid transition
  type: http
  seq: 2
}

put {
  url: {{mapUrl}}/maps/{{mapGtiStage2Id}}/validate
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 400", function() {
    expect(res.status).to.equal(400);
  });
  test("has error message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
