meta {
  name: Validate - in_development to validated
  type: http
  seq: 3
}

put {
  url: {{mapUrl}}/maps/{{mapGtiStage1Id}}/validate
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("status is validated", function() {
    expect(res.body.status).to.equal("validated");
  });
}
