meta {
  name: Register Duplicate VIN - 409
  type: http
  seq: 11
}

post {
  url: {{clientVehicleUrl}}/client-vehicles
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "ownerId": "{{adminId}}",
    "configId": "507f1f77bcf86cd799439011",
    "vin": "WVWZZZ1KZAM012345",
    "plateNumber": "DUP-001"
  }
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
