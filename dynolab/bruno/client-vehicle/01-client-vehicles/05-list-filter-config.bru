meta {
  name: List Vehicles - Filter by configId
  type: http
  seq: 5
}

get {
  url: {{clientVehicleUrl}}/client-vehicles?configId=507f1f77bcf86cd799439011
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has vehicles array", function() {
    expect(res.body.vehicles).to.be.an("array");
  });
  test("all vehicles match configId", function() {
    res.body.vehicles.forEach(function(v) {
      expect(v.configId).to.equal("507f1f77bcf86cd799439011");
    });
  });
}
