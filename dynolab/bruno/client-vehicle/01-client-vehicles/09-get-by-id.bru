meta {
  name: Get Vehicle By Id (includes modifications)
  type: http
  seq: 9
}

get {
  url: {{clientVehicleUrl}}/client-vehicles/{{vehicleId}}
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("id matches", function() {
    expect(res.body.id).to.equal(bru.getVar("vehicleId"));
  });
  test("has ownerId", function() {
    expect(res.body.ownerId).to.be.a("string");
  });
  test("has configId", function() {
    expect(res.body.configId).to.be.a("string");
  });
  test("has vin", function() {
    expect(res.body.vin).to.be.a("string");
  });
  test("has modifications array", function() {
    expect(res.body.modifications).to.be.an("array");
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
