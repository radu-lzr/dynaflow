meta {
  name: List Client Vehicles
  type: http
  seq: 3
}

get {
  url: {{clientVehicleUrl}}/client-vehicles
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has vehicles array", function() {
    expect(res.body.vehicles).to.be.an("array");
  });
  test("has totalCount", function() {
    expect(res.body.totalCount).to.be.a("number");
  });
  test("has page", function() {
    expect(res.body.page).to.be.a("number");
  });
  test("has limit", function() {
    expect(res.body.limit).to.be.a("number");
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
