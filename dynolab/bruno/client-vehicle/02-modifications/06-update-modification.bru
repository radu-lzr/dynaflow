meta {
  name: Update Modification
  type: http
  seq: 6
}

put {
  url: {{clientVehicleUrl}}/client-vehicles/{{vehicleId}}/modifications/{{modificationId}}
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "description": "Upgraded to IS38 hybrid turbo with ported compressor housing"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
