meta {
  name: Update Nonexistent Modification - 404
  type: http
  seq: 10
}

put {
  url: {{clientVehicleUrl}}/client-vehicles/{{vehicleId}}/modifications/00000000-0000-0000-0000-000000000000
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "description": "Does not exist"
  }
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
