meta {
  name: Verify Vehicle Deleted (cascade verified via 404)
  type: http
  seq: 13
}

get {
  url: {{clientVehicleUrl}}/client-vehicles/{{vehicleId}}
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
