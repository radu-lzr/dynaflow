meta {
  name: Add Modification to Nonexistent Vehicle - 404
  type: http
  seq: 8
}

post {
  url: {{clientVehicleUrl}}/client-vehicles/00000000-0000-0000-0000-000000000000/modifications
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "category": "turbo",
    "description": "Ghost modification"
  }
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
