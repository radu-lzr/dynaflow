meta {
  name: Get Vehicle By Id - Includes Modifications
  type: http
  seq: 5
}

get {
  url: {{clientVehicleUrl}}/client-vehicles/{{vehicleId}}
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("modifications included", function() {
    expect(res.body.modifications).to.be.an("array");
  });
  test("modifications count is 3", function() {
    expect(res.body.modifications.length).to.equal(3);
  });
  test("modification has category", function() {
    expect(res.body.modifications[0].category).to.be.a("string");
  });
  test("modification has description", function() {
    expect(res.body.modifications[0].description).to.be.a("string");
  });
}
