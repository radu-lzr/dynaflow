meta {
  name: Add Exhaust Modification
  type: http
  seq: 2
}

post {
  url: {{clientVehicleUrl}}/client-vehicles/{{vehicleId}}/modifications
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "category": "exhaust",
    "description": "Milltek non-resonated cat-back exhaust",
    "installedAt": "2024-04-01"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
