meta {
  name: List Modifications for Vehicle
  type: http
  seq: 4
}

get {
  url: {{clientVehicleUrl}}/client-vehicles/{{vehicleId}}/modifications
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has modifications array", function() {
    expect(res.body.modifications).to.be.an("array");
  });
  test("has 3 modifications", function() {
    expect(res.body.modifications.length).to.equal(3);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
