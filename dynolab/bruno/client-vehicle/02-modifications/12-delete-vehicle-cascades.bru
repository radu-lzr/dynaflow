meta {
  name: Delete Vehicle (cascades modifications)
  type: http
  seq: 12
}

delete {
  url: {{clientVehicleUrl}}/client-vehicles/{{vehicleId}}
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
