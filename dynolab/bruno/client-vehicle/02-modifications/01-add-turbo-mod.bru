meta {
  name: Add Turbo Modification
  type: http
  seq: 1
}

post {
  url: {{clientVehicleUrl}}/client-vehicles/{{vehicleId}}/modifications
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "category": "turbo",
    "description": "Upgraded to IS38 hybrid turbo",
    "installedAt": "2024-03-15"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}

script:post-response {
  if (res.body.id) {
    bru.setVar("modificationId", res.body.id);
  }
}
