meta {
  name: List Members
  type: http
  seq: 2
}

get {
  url: {{siteUrl}}/sites/{{memberSiteId}}/members
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has items array", function() {
    expect(res.body.items).to.be.an("array");
  });
  test("at least one member", function() {
    expect(res.body.items.length).to.be.greaterThan(0);
  });
  test("item has userId and joinedAt", function() {
    const member = res.body.items[0];
    expect(member.userId).to.be.a("string");
    expect(member.joinedAt).to.be.a("string");
  });
}
