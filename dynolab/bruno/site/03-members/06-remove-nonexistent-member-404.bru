meta {
  name: Remove Nonexistent Member 404
  type: http
  seq: 6
}

delete {
  url: {{siteUrl}}/sites/{{memberSiteId}}/members/{{techId}}
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
