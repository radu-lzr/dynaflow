meta {
  name: Setup - Create Site For Equipment Tests
  type: http
  seq: 0
}

post {
  url: {{siteUrl}}/sites
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "name": "Paris Workshop",
    "city": "Paris",
    "country": "France"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
}

script:post-response {
  if (res.body.id) {
    bru.setVar("equipmentSiteId", res.body.id);
  }
}
