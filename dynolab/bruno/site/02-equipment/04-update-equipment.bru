meta {
  name: Update Equipment
  type: http
  seq: 4
}

put {
  url: {{siteUrl}}/sites/{{equipmentSiteId}}/equipment/{{equipmentId}}
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "brand": "Mustang Dynamometer",
    "isOperational": true
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
