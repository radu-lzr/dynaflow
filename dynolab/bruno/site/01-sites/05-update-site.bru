meta {
  name: Update Site
  type: http
  seq: 5
}

put {
  url: {{siteUrl}}/sites/{{siteId}}
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "name": "Lyon Workshop Updated",
    "city": "Lyon"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("name is updated", function() {
    expect(res.body.name).to.equal("Lyon Workshop Updated");
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
