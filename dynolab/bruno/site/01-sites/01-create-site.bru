meta {
  name: Create Site
  type: http
  seq: 1
}

post {
  url: {{siteUrl}}/sites
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "name": "Lyon Workshop",
    "address": "12 Rue des Mécaniciens",
    "city": "Lyon",
    "country": "France"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}

script:post-response {
  if (res.body.id) {
    bru.setVar("siteId", res.body.id);
  }
}
