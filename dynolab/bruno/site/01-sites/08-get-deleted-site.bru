meta {
  name: Get Deleted Site (still returns with isActive false)
  type: http
  seq: 8
}

get {
  url: {{siteUrl}}/sites/{{siteId}}
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("isActive is false", function() {
    expect(res.body.isActive).to.equal(false);
  });
}
