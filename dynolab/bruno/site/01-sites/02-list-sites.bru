meta {
  name: List Sites
  type: http
  seq: 2
}

get {
  url: {{siteUrl}}/sites
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has items array", function() {
    expect(res.body.items).to.be.an("array");
  });
  test("has totalCount", function() {
    expect(res.body.totalCount).to.be.a("number");
  });
  test("has pagination fields", function() {
    expect(res.body.page).to.be.a("number");
    expect(res.body.limit).to.be.a("number");
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
