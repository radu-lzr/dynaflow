meta {
  name: Update Vehicle Not Found 404
  type: http
  seq: 13
}

put {
  url: {{vehicleUrl}}/vehicles/000000000000000000000000
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "stockHp": 300
  }
}

tests {
  test("status 404", function() {
    expect(res.status).to.equal(404);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
