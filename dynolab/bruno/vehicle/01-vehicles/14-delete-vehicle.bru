meta {
  name: Delete Vehicle
  type: http
  seq: 14
}

delete {
  url: {{vehicleUrl}}/vehicles/{{mx5Id}}
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
