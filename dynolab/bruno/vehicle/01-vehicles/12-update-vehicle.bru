meta {
  name: Update Vehicle Partial
  type: http
  seq: 12
}

put {
  url: {{vehicleUrl}}/vehicles/{{golfGtiId}}
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "stockHp": 245,
    "specs": {
      "turbo": "IHI IS38",
      "injectors": "direct 350cc",
      "intake": "aftermarket",
      "intercooler": "FMIC"
    }
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("id matches", function() {
    expect(res.body.id).to.equal(bru.getVar("golfGtiId"));
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
