meta {
  name: List With Pagination
  type: http
  seq: 5
}

get {
  url: {{vehicleUrl}}/vehicles?page=1&limit=2
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("returns at most 2 vehicles", function() {
    expect(res.body.vehicles.length).to.be.at.most(2);
  });
  test("page is 1 and limit is 2", function() {
    expect(res.body.page).to.equal(1);
    expect(res.body.limit).to.equal(2);
  });
  test("totalCount is at least 3", function() {
    expect(res.body.totalCount).to.be.at.least(3);
  });
}
