meta {
  name: Create Bench Only Intervention
  type: http
  seq: 3
}

post {
  url: {{workshopUrl}}/interventions
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "clientVehicleId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
    "siteId": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
    "technicianId": "{{techId}}",
    "type": "bench_only"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
}

script:post-response {
  if (res.body.id) {
    bru.setVar("benchOnlyInterventionId", res.body.id);
  }
}
