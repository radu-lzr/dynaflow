meta {
  name: Update Intervention (notes and mapVersionId)
  type: http
  seq: 8
}

put {
  url: {{workshopUrl}}/interventions/{{diagInterventionId}}
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "notes": "Updated notes after initial inspection"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
}
