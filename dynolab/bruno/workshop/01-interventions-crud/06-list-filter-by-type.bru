meta {
  name: List Interventions (filter by type)
  type: http
  seq: 6
}

get {
  url: {{workshopUrl}}/interventions?type=remap
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("all items are remap type", function() {
    res.body.interventions.forEach(function(i) {
      expect(i.type).to.equal("remap");
    });
  });
}
