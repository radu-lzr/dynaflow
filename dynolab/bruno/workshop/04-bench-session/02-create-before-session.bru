meta {
  name: Create Bench Session "before" via Intervention Proxy
  type: http
  seq: 2
}

post {
  url: {{workshopUrl}}/interventions/{{benchProxyInterventionId}}/bench-session
  body: json
  auth: none
}

headers {
  X-User-Id: {{techId}}
}

body:json {
  {
    "type": "before",
    "notes": "Baseline run before any modification"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has sessionId", function() {
    expect(res.body.sessionId).to.be.a("string");
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}

script:post-response {
  if (res.body.sessionId) {
    bru.setVar("beforeSessionId", res.body.sessionId);
  }
}
