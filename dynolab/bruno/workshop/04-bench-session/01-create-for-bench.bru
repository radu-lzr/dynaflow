meta {
  name: Create Intervention for Bench Session Tests
  type: http
  seq: 1
}

post {
  url: {{workshopUrl}}/interventions
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "clientVehicleId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
    "siteId": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
    "technicianId": "{{techId}}",
    "type": "bench_only",
    "notes": "Bench session proxy test"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
}

script:post-response {
  if (res.body.id) {
    bru.setVar("benchProxyInterventionId", res.body.id);
  }
}
