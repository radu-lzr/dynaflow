meta {
  name: Reassign on Completed Intervention → 400
  type: http
  seq: 6
}

put {
  url: {{workshopUrl}}/interventions/{{assignInterventionId}}/assign
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "technicianId": "{{techId}}"
  }
}

tests {
  test("status 400 (cannot reassign completed)", function() {
    expect(res.status).to.equal(400);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
