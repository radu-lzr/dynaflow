meta {
  name: Deliver Intervention (completed → delivered)
  type: http
  seq: 7
}

put {
  url: {{workshopUrl}}/interventions/{{lifecycleInterventionId}}/deliver
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("status is delivered", function() {
    expect(res.body.status).to.equal("delivered");
  });
}
