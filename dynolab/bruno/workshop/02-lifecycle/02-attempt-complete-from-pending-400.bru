meta {
  name: Attempt Complete from Pending → 400
  type: http
  seq: 2
}

put {
  url: {{workshopUrl}}/interventions/{{lifecycleInterventionId}}/complete
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {}
}

tests {
  test("status 400 (cannot complete from pending)", function() {
    expect(res.status).to.equal(400);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
