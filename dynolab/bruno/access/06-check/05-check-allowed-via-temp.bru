meta {
  name: Check Access Allowed Via Temp Permission 200
  type: http
  seq: 5
}

post {
  url: {{accessUrl}}/access/check
  body: json
  auth: none
}

body:json {
  {
    "userId": "{{techId}}",
    "method": "GET",
    "path": "/roles"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("allowed is true", function() {
    expect(res.body.allowed).to.equal(true);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
