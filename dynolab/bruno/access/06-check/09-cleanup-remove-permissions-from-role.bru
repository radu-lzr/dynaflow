meta {
  name: Cleanup Remove Permissions From Role
  type: http
  seq: 9
}

delete {
  url: {{accessUrl}}/roles/{{roleId}}/permissions
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "permissionIds": ["{{permissionId}}"]
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
