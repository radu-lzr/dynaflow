meta {
  name: Cleanup Remove Role From User
  type: http
  seq: 8
}

delete {
  url: {{accessUrl}}/user-roles
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "userId": "{{techId}}",
    "roleId": "{{roleId}}"
  }
}

tests {
  test("status 200 or 404", function() {
    expect([200, 404]).to.include(res.status);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
