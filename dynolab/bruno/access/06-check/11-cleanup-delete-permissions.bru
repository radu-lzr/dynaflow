meta {
  name: Cleanup Delete Permissions
  type: http
  seq: 11
}

delete {
  url: {{accessUrl}}/permissions/{{permissionId}}
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200, 404 or 409", function() {
    expect([200, 404, 409]).to.include(res.status);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
