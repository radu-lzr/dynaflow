meta {
  name: Cleanup Delete Permissions
  type: http
  seq: 11
}

delete {
  url: {{accessUrl}}/permissions/{{permissionId}}
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
