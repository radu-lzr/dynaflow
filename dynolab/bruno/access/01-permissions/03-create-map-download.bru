meta {
  name: Create Permission map:download
  type: http
  seq: 3
}

post {
  url: {{accessUrl}}/permissions
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "permissionCode": "map:download",
    "description": "Download a map"
  }
}

tests {
  test("status 201 or 409", function() {
    expect([201, 409]).to.include(res.status);
  });
  test("has id when created", function() {
    if (res.status === 201) {
      expect(res.body.id).to.be.a("string");
    }
  });
}

script:post-response {
  if (res.body.id) {
    bru.setVar("mapDownloadPermId", res.body.id);
  }
}
