meta {
  name: Create Permission map:download
  type: http
  seq: 3
}

post {
  url: {{accessUrl}}/permissions
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "permissionCode": "map:download",
    "description": "Download a map"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
}

script:post-response {
  bru.setVar("mapDownloadPermId", res.body.id);
}
