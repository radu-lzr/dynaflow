meta {
  name: Create Permission user:list
  type: http
  seq: 2
}

post {
  url: {{accessUrl}}/permissions
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "permissionCode": "user:list",
    "description": "List all users"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}

script:post-response {
  bru.setVar("permissionId", res.body.id);
}
