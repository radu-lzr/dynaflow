meta {
  name: Create Duplicate Permission 409
  type: http
  seq: 4
}

post {
  url: {{accessUrl}}/permissions
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "permissionCode": "user:read",
    "description": "Duplicate permission"
  }
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
