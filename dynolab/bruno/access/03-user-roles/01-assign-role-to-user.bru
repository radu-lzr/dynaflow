meta {
  name: Assign Role To User
  type: http
  seq: 1
}

post {
  url: {{accessUrl}}/user-roles
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "userId": "{{techId}}",
    "roleId": "{{roleId}}"
  }
}

tests {
  test("status 201 or 409", function() {
    expect([201, 409]).to.include(res.status);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
