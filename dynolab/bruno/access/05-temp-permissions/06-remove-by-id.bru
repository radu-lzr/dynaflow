meta {
  name: Remove Temp Permission By Id
  type: http
  seq: 6
}

delete {
  url: {{accessUrl}}/temp-permissions/{{tempPermId}}
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
