meta {
  name: Create Role
  type: http
  seq: 2
}

post {
  url: {{accessUrl}}/roles
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "name": "Test Role",
    "description": "Role created by Bruno tests"
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("has id", function() {
    expect(res.body.id).to.be.a("string");
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}

script:post-response {
  bru.setVar("roleId", res.body.id);
}
