meta {
  name: List Roles
  type: http
  seq: 1
}

get {
  url: {{accessUrl}}/roles
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has roles array", function() {
    expect(res.body.roles).to.be.an("array");
  });
  test("has totalCount", function() {
    expect(res.body.totalCount).to.be.a("number");
  });
  test("has page", function() {
    expect(res.body.page).to.be.a("number");
  });
  test("has limit", function() {
    expect(res.body.limit).to.be.a("number");
  });
}
