meta {
  name: Assign Duplicate Permission To User 409
  type: http
  seq: 2
}

post {
  url: {{accessUrl}}/user-permissions
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "userId": "{{techId}}",
    "permissionCode": "map:download",
    "resourceId": "{{techId}}"
  }
}

tests {
  test("status 409", function() {
    expect(res.status).to.equal(409);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
