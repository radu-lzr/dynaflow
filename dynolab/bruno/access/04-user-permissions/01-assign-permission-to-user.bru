meta {
  name: Assign Permission To User
  type: http
  seq: 1
}

post {
  url: {{accessUrl}}/user-permissions
  body: json
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

body:json {
  {
    "userId": "{{techId}}",
    "permissionCode": "map:download",
    "resourceId": "{{techId}}"
  }
}

tests {
  test("status 201 or 409", function() {
    expect([201, 409]).to.include(res.status);
  });
  test("has id when created", function() {
    if (res.status === 201) {
      expect(res.body.id).to.be.a("string");
    }
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}

script:post-response {
  if (res.body.id) {
    bru.setVar("userPermId", res.body.id);
  }
}
