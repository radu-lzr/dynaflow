meta {
  name: Verify Access Invalid Token 401
  type: http
  seq: 2
}

post {
  url: {{accessUrl}}/access/verify
  body: none
  auth: none
}

headers {
  Authorization: Bearer invalid.token.here
  X-Original-URI: /api/access/roles
  X-Original-Method: GET
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });
  test("has message", function() {
    expect(res.body.message).to.be.a("string");
  });
}
