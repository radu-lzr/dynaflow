meta {
  name: Login Admin For Verify Tests
  type: http
  seq: 0
}

post {
  url: {{authUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "Admin123!"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("has accessToken", function() {
    expect(res.body.accessToken).to.be.a("string");
  });
}

script:post-response {
  bru.setVar("verifyTestToken", res.body.accessToken);
  bru.setVar("verifyUserId", res.body.userId);
}
