meta {
  name: Load Existing Permissions
  type: http
  seq: 1
}

get {
  url: {{accessUrl}}/permissions?limit=100
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
}

script:post-response {
  // user:read is seeded — use it as the permission for role assignment in check tests
  const userReadPermission = res.body.permissions.find(function(item) {
    return item.permissionCode === "user:read";
  });

  const mapDownloadPermission = res.body.permissions.find(function(item) {
    return item.permissionCode === "map:download";
  });

  if (userReadPermission) {
    bru.setVar("permissionId", userReadPermission.id);
  }

  if (mapDownloadPermission) {
    bru.setVar("mapDownloadPermId", mapDownloadPermission.id);
  }
}