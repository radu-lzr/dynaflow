meta {
  name: Load Existing User Permissions
  type: http
  seq: 2
}

get {
  url: {{accessUrl}}/user-permissions/{{techId}}
  body: none
  auth: none
}

headers {
  X-User-Id: {{adminId}}
}

tests {
  test("status 200 or 404", function() {
    expect([200, 404]).to.include(res.status);
  });
}

script:post-response {
  if (res.status === 200 && res.body.permissions) {
    const directPermission = res.body.permissions.find(function(item) {
      return item.permissionCode === "map:download" && item.resourceId === "{{techId}}";
    });

    if (directPermission) {
      bru.setVar("userPermId", directPermission.id);
    }
  }
}