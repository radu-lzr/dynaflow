# ── Shared Postgres ───────────────────────────────────────────
POSTGRES_USER=dynolab
POSTGRES_PASSWORD=dynolab_dev

# ── Postgres databases ────────────────────────────────────────
PG_AUTH_DB=dynolab_auth
PG_ACCESS_DB=dynolab_access
PG_SITE_DB=dynolab_site
PG_CLIENT_VEHICLE_DB=dynolab_client_vehicle
PG_MAP_DB=dynolab_map
PG_WORKSHOP_DB=dynolab_workshop
TIMESCALE_DB=dynolab_telemetry

# ── MongoDB ───────────────────────────────────────────────────
MONGO_USER=dynolab
MONGO_PASSWORD=dynolab_dev
MONGO_DB=dynolab_vehicle

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_USER=dynolab
RABBITMQ_PASS=dynolab_dev

# ── MinIO ─────────────────────────────────────────────────────
MINIO_ROOT_USER=dynolab
MINIO_ROOT_PASSWORD=dynolab_dev

# ── Auth service ──────────────────────────────────────────────
AUTH_PORT=4001
JWT_SECRET=changeme_in_production
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15
LOG_LEVEL=info
